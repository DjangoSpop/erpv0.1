@model Motel.Application.DTOs.ClientDto
@{
    ViewData["Title"] = "تفاصيل النزيل";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>تفاصيل النزيل</h2>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> تعديل
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-right"></i> رجوع
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-circle"></i> البيانات الشخصية</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">الاسم الكامل:</div>
                    <div class="col-md-8">@Model.FullName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">رقم الهوية / جواز السفر:</div>
                    <div class="col-md-8">@Model.NationalIdOrPassport</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">رقم الهاتف:</div>
                    <div class="col-md-8">
                        <i class="bi bi-telephone"></i> @Model.Phone
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">البريد الإلكتروني:</div>
                    <div class="col-md-8">
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <i class="bi bi-envelope"></i> <a href="mailto:@Model.Email">@Model.Email</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="row">
                        <div class="col-md-4 fw-bold">ملاحظات:</div>
                        <div class="col-md-8">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('هل أنت متأكد من حذف هذا النزيل؟ سيتم حذف جميع الحجوزات المرتبطة به.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> حذف النزيل
                </button>
            </form>
        </div>
    </div>
</div>
