@model IEnumerable<Motel.Application.DTOs.ClientDto>
@{
    ViewData["Title"] = "النزلاء";
    var search = ViewBag.Search as string;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2>إدارة النزلاء</h2>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> إضافة نزيل جديد
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-10">
                <input type="text" name="search" class="form-control" placeholder="بحث بالاسم، رقم الهوية، أو الهاتف..." value="@search" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> بحث
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>الاسم الكامل</th>
                        <th>رقم الهوية/جواز السفر</th>
                        <th>الهاتف</th>
                        <th>البريد الإلكتروني</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">لا توجد بيانات</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var client in Model)
                        {
                            <tr>
                                <td><strong>@client.FullName</strong></td>
                                <td>@client.NationalIdOrPassport</td>
                                <td><i class="bi bi-telephone"></i> @client.Phone</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.Email))
                                    {
                                        <i class="bi bi-envelope"></i> @client.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@client.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('هل أنت متأكد من حذف هذا النزيل؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
