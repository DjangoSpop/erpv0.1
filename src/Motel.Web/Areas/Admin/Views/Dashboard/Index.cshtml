@model Motel.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="row mb-4">
    <div class="col">
        <h2>لوحة التحكم</h2>
        <p class="text-muted">@DateTime.Now.ToString("dddd، dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-door-open"></i> الغرف المتاحة</h5>
                <h2 class="card-text">@Model.AvailableRooms</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-door-closed"></i> الغرف المشغولة</h5>
                <h2 class="card-text">@Model.OccupiedRooms</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-calendar-check"></i> الغرف المحجوزة</h5>
                <h2 class="card-text">@Model.ReservedRooms</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-percent"></i> نسبة الإشغال</h5>
                <h2 class="card-text">@Model.OccupancyRate.ToString("F1")%</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <h6 class="card-title text-primary">تسجيلات الوصول اليوم</h6>
                <h3 class="card-text">@Model.TodayCheckIns</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-danger">
            <div class="card-body">
                <h6 class="card-title text-danger">تسجيلات المغادرة اليوم</h6>
                <h3 class="card-text">@Model.TodayCheckOuts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <h6 class="card-title text-success">إيرادات اليوم</h6>
                <h3 class="card-text">@Model.TodayRevenue.ToString("N2") ج.م</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body">
                <h6 class="card-title text-info">إيرادات الشهر</h6>
                <h3 class="card-text">@Model.MonthRevenue.ToString("N2") ج.م</h3>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">روابط سريعة</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <a href="@Url.Action("Create", "Reservations")" class="list-group-item list-group-item-action">
                        <i class="bi bi-plus-circle"></i> إنشاء حجز جديد
                    </a>
                    <a href="@Url.Action("Create", "Clients")" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-plus"></i> إضافة نزيل جديد
                    </a>
                    <a href="@Url.Action("Index", "Invoices")" class="list-group-item list-group-item-action">
                        <i class="bi bi-receipt"></i> عرض الفواتير
                    </a>
                    <a href="@Url.Action("Occupancy", "Reports")" class="list-group-item list-group-item-action">
                        <i class="bi bi-graph-up"></i> تقرير الإشغال
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
