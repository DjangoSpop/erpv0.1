@model Motel.Application.DTOs.InvoiceDto
@{
    ViewData["Title"] = "طباعة الفاتورة";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>فاتورة - @Model.Serial</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        @@media print {
            .no-print { display: none; }
            body { font-size: 12pt; }
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>
<body>
    <div class="container mt-3 no-print">
        <button onclick="window.print()" class="btn btn-primary">
            <i class="bi bi-printer"></i> طباعة
        </button>
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary">رجوع</a>
    </div>

    <div class="invoice-box">
        <div class="text-center mb-4">
            <h2>فاتورة ضريبية</h2>
            <p class="text-muted">رقم الفاتورة: @Model.Serial</p>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <strong>تاريخ الإصدار:</strong><br />
                @Model.IssuedAtUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")
            </div>
            <div class="col-6 text-end">
                <strong>حالة الدفع:</strong><br />
                @if (Model.Status == Motel.Domain.Enums.InvoiceStatus.Paid)
                {
                    <span class="badge bg-success">مدفوعة</span>
                }
                else
                {
                    <span class="badge bg-warning">غير مدفوعة</span>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">بيانات النزيل</h5>
                <p class="mb-1"><strong>الاسم:</strong> @Model.ClientName</p>
                <p class="mb-1"><strong>الغرفة:</strong> @Model.RoomNumber</p>
                <p class="mb-1"><strong>الفترة:</strong> من @Model.CheckInDate.ToString("dd/MM/yyyy") إلى @Model.CheckOutDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>البيان</th>
                    <th class="text-end">المبلغ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>المجموع الفرعي</td>
                    <td class="text-end">@Model.Subtotal.ToString("N2") ج.م</td>
                </tr>
                <tr>
                    <td>ضريبة القيمة المضافة (@Model.TaxPercent%)</td>
                    <td class="text-end">@Model.TaxAmount.ToString("N2") ج.م</td>
                </tr>
                <tr class="table-primary">
                    <td><strong>الإجمالي</strong></td>
                    <td class="text-end"><strong>@Model.Total.ToString("N2") ج.م</strong></td>
                </tr>
            </tbody>
        </table>

        @if (Model.Status == Motel.Domain.Enums.InvoiceStatus.Paid && Model.PaymentMethod.HasValue)
        {
            <div class="alert alert-success">
                <strong>تم الدفع بواسطة:</strong>
                @switch (Model.PaymentMethod.Value)
                {
                    case Motel.Domain.Enums.PaymentMethod.Cash:
                        <span>نقداً</span>
                        break;
                    case Motel.Domain.Enums.PaymentMethod.Card:
                        <span>بطاقة ائتمان</span>
                        break;
                    case Motel.Domain.Enums.PaymentMethod.BankTransfer:
                        <span>تحويل بنكي</span>
                        break;
                    case Motel.Domain.Enums.PaymentMethod.MobileWallet:
                        <span>محفظة إلكترونية</span>
                        break;
                }
                <br />
                <strong>تاريخ الدفع:</strong> @Model.PaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")
            </div>
        }

        <div class="text-center mt-5 text-muted">
            <p>شكراً لتعاملكم معنا</p>
        </div>
    </div>
</body>
</html>
