@model IEnumerable<Motel.Application.Interfaces.MonthlyRevenueDto>
@{
    ViewData["Title"] = "تقرير الإيرادات";
    var year = ViewBag.Year as int?;
}

<div class="row mb-3">
    <div class="col">
        <h2>تقرير الإيرادات الشهرية</h2>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Revenue" method="get" class="row g-3">
            <div class="col-md-10">
                <label class="form-label">السنة</label>
                <input type="number" name="year" class="form-control" value="@year" min="2020" max="2099" />
            </div>
            <div class="col-md-2">
                <label class="form-label d-block">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> عرض
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>الشهر</th>
                        <th class="text-center">عدد الفواتير</th>
                        <th class="text-end">إجمالي الإيرادات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">لا توجد بيانات لهذه السنة</td>
                        </tr>
                    }
                    else
                    {
                        decimal totalRevenue = 0;
                        int totalInvoices = 0;

                        @foreach (var item in Model)
                        {
                            totalRevenue += item.TotalRevenue;
                            totalInvoices += item.InvoiceCount;

                            <tr>
                                <td><strong>@item.MonthName @item.Year</strong></td>
                                <td class="text-center">@item.InvoiceCount</td>
                                <td class="text-end text-success">@item.TotalRevenue.ToString("N2") ج.م</td>
                            </tr>
                        }

                        <tr class="table-primary fw-bold">
                            <td>الإجمالي</td>
                            <td class="text-center">@totalInvoices</td>
                            <td class="text-end text-success fs-5">@totalRevenue.ToString("N2") ج.م</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="card mt-3">
        <div class="card-body">
            <canvas id="revenueChart" height="60"></canvas>
        </div>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    @if (Model.Any())
    {
        <text>
        const ctx = document.getElementById('revenueChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.Select(m => $"'{m.MonthName}'")))],
                datasets: [{
                    label: 'الإيرادات (ج.م)',
                    data: [@Html.Raw(string.Join(",", Model.Select(m => m.TotalRevenue)))],
                    backgroundColor: '#28a745',
                    borderColor: '#1e7e34',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    title: {
                        display: true,
                        text: 'الإيرادات الشهرية لعام @year'
                    }
                }
            }
        });
        </text>
    }
</script>
}
