@model Motel.Web.ViewModels.Reservations.CheckInViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="row mb-3">
    <div class="col">
        <h2><i class="bi bi-box-arrow-in-right"></i> تسجيل دخول الحجز</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">الحجوزات</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ReservationId">تفاصيل</a></li>
                <li class="breadcrumb-item active">تسجيل الدخول</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Reservation Summary -->
<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> معلومات الحجز</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <strong>النزيل:</strong> @Model.ClientName
            </div>
            <div class="col-md-4">
                <strong>رقم الغرفة:</strong> @Model.RoomNumber
            </div>
            <div class="col-md-4">
                <strong>تاريخ الدخول المجدول:</strong> @Model.ScheduledCheckInDate.ToString("dd/MM/yyyy")
            </div>
        </div>
        @if (Model.IsEarlyCheckIn)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>تنبيه:</strong> هذا دخول مبكر. التاريخ المجدول: @Model.ScheduledCheckInDate.ToString("dd/MM/yyyy")
            </div>
        }
    </div>
</div>

<!-- Check-In Form -->
<form asp-action="CheckIn" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReservationId" />
    <input type="hidden" asp-for="ClientName" />
    <input type="hidden" asp-for="RoomNumber" />
    <input type="hidden" asp-for="ScheduledCheckInDate" />

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-calendar-check"></i> بيانات تسجيل الدخول</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Actual Check-In Time -->
                <div class="col-md-6">
                    <label asp-for="ActualCheckInTime" class="form-label">
                        وقت تسجيل الدخول الفعلي <span class="text-danger">*</span>
                    </label>
                    <input asp-for="ActualCheckInTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ActualCheckInTime" class="text-danger"></span>
                </div>

                <!-- Actual Number of Guests -->
                <div class="col-md-6">
                    <label asp-for="ActualGuests" class="form-label">
                        عدد النزلاء الفعلي <span class="text-danger">*</span>
                    </label>
                    <input asp-for="ActualGuests" type="number" class="form-control" min="1" />
                    <span asp-validation-for="ActualGuests" class="text-danger"></span>
                </div>

                <!-- Document Number -->
                <div class="col-md-6">
                    <label asp-for="DocumentNumber" class="form-label">
                        رقم الهوية / جواز السفر
                    </label>
                    <input asp-for="DocumentNumber" class="form-control" placeholder="أدخل رقم الوثيقة" />
                    <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                </div>

                <!-- Documents Collected -->
                <div class="col-md-6">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="form-check">
                        <input asp-for="DocumentsCollected" class="form-check-input" />
                        <label asp-for="DocumentsCollected" class="form-check-label">
                            تم جمع المستندات المطلوبة
                        </label>
                    </div>
                </div>

                <!-- Early Check-In Fee -->
                @if (Model.IsEarlyCheckIn)
                {
                    <div class="col-md-6">
                        <label asp-for="EarlyCheckInFee" class="form-label">
                            رسوم الدخول المبكر (ج.م)
                        </label>
                        <input asp-for="EarlyCheckInFee" type="number" class="form-control" step="0.01" />
                        <span asp-validation-for="EarlyCheckInFee" class="text-danger"></span>
                    </div>
                }

                <!-- Special Requests -->
                <div class="col-12">
                    <label class="form-label">طلبات خاصة</label>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" value="غرفة هادئة" id="req1" />
                        <label class="form-check-label" for="req1">غرفة هادئة</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" value="إطلالة على البحر" id="req2" />
                        <label class="form-check-label" for="req2">إطلالة على البحر</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" value="طابق عالي" id="req3" />
                        <label class="form-check-label" for="req3">طابق عالي</label>
                    </div>
                </div>

                <!-- Additional Notes -->
                <div class="col-12">
                    <label asp-for="CheckInNotes" class="form-label">ملاحظات إضافية</label>
                    <textarea asp-for="CheckInNotes" class="form-control" rows="3"
                              placeholder="أي ملاحظات أو تعليمات خاصة..."></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-12 d-flex justify-content-between">
                    <div>
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-check-circle"></i> تأكيد تسجيل الدخول
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ReservationId" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle"></i> إلغاء
                        </a>
                    </div>
                    @if (Model.IsEarlyCheckIn)
                    {
                        <div class="text-end">
                            <span class="badge bg-warning text-dark fs-6">
                                دخول مبكر - قد يطبق رسوم إضافية
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Set current date/time as default
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const datetime = `${year}-${month}-${day}T${hours}:${minutes}`;

            const input = document.querySelector('input[name="ActualCheckInTime"]');
            if (input && !input.value) {
                input.value = datetime;
            }
        });
    </script>
}
