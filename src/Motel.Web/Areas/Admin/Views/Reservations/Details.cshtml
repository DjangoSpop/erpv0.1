@model Motel.Application.DTOs.ReservationDto
@{
    ViewData["Title"] = "تفاصيل الحجز";
    var invoice = ViewBag.Invoice as Motel.Application.DTOs.InvoiceDto;
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>تفاصيل الحجز</h2>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-right"></i> رجوع
            </a>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-calendar-check"></i> معلومات الحجز</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-md-4 fw-bold">النزيل:</div>
                            <div class="col-md-8">@Model.ClientName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-4 fw-bold">الغرفة:</div>
                            <div class="col-md-8">@Model.RoomNumber</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-4 fw-bold">تاريخ الوصول:</div>
                            <div class="col-md-8">@Model.CheckInDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-4 fw-bold">تاريخ المغادرة:</div>
                            <div class="col-md-8">@Model.CheckOutDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-4 fw-bold">عدد الليالي:</div>
                            <div class="col-md-8">@Model.Nights ليلة</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-4 fw-bold">عدد النزلاء:</div>
                            <div class="col-md-8">@Model.Guests شخص</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="row">
                                <div class="col-md-4 fw-bold">ملاحظات:</div>
                                <div class="col-md-8">@Model.Notes</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-cash-stack"></i> التكاليف</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-md-6">السعر / ليلة:</div>
                            <div class="col-md-6 text-end">@Model.NightlyRate.ToString("N2") ج.م</div>
                        </div>
                        @if (Model.ExtraCharges.HasValue && Model.ExtraCharges.Value > 0)
                        {
                            <div class="row mb-2">
                                <div class="col-md-6">رسوم إضافية:</div>
                                <div class="col-md-6 text-end">@Model.ExtraCharges.Value.ToString("N2") ج.م</div>
                            </div>
                        }
                        @if (Model.DiscountAmount.HasValue && Model.DiscountAmount.Value > 0)
                        {
                            <div class="row mb-2 text-danger">
                                <div class="col-md-6">خصم:</div>
                                <div class="col-md-6 text-end">-@Model.DiscountAmount.Value.ToString("N2") ج.م</div>
                            </div>
                        }
                        <hr />
                        <div class="row">
                            <div class="col-md-6 fw-bold">المجموع:</div>
                            <div class="col-md-6 text-end fw-bold text-success fs-5">@Model.TotalAmount.ToString("N2") ج.م</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-gear"></i> الإجراءات</h5>
                    </div>
                    <div class="card-body">
                        @if (!Model.CheckedIn)
                        {
                            <form asp-action="CheckIn" asp-route-id="@Model.Id" method="post" class="mb-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-box-arrow-in-right"></i> تسجيل الدخول
                                </button>
                            </form>
                        }
                        else if (!Model.CheckedOut)
                        {
                            <div class="alert alert-success mb-2">
                                <i class="bi bi-check-circle"></i> تم تسجيل الدخول
                            </div>

                            <form asp-action="CheckOut" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('هل تريد تسجيل الخروج؟')">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label">رسوم إضافية (اختياري)</label>
                                    <input type="number" name="extraCharges" step="0.01" class="form-control" value="0" />
                                </div>
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-secondary">
                                <i class="bi bi-check-all"></i> اكتمل الحجز
                            </div>
                        }

                        <hr />

                        @if (invoice == null && Model.CheckedOut)
                        {
                            <form asp-controller="Invoices" asp-action="Issue" asp-route-reservationId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary w-100 mb-2">
                                    <i class="bi bi-receipt"></i> إصدار فاتورة
                                </button>
                            </form>
                        }
                        else if (invoice != null)
                        {
                            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-info w-100 mb-2">
                                <i class="bi bi-receipt"></i> عرض الفاتورة
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
