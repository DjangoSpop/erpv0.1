@model Motel.Application.DTOs.RoomDto
@{
    ViewData["Title"] = "تفاصيل الغرفة";
    var statusBadge = Model.Status switch
    {
        Motel.Domain.Enums.RoomStatus.Available => "bg-success",
        Motel.Domain.Enums.RoomStatus.Occupied => "bg-danger",
        Motel.Domain.Enums.RoomStatus.Reserved => "bg-warning",
        Motel.Domain.Enums.RoomStatus.OutOfService => "bg-secondary",
        _ => "bg-secondary"
    };
    var statusText = Model.Status switch
    {
        Motel.Domain.Enums.RoomStatus.Available => "متاحة",
        Motel.Domain.Enums.RoomStatus.Occupied => "مشغولة",
        Motel.Domain.Enums.RoomStatus.Reserved => "محجوزة",
        Motel.Domain.Enums.RoomStatus.OutOfService => "خارج الخدمة",
        _ => Model.Status.ToString()
    };
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>تفاصيل الغرفة</h2>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> تعديل
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-right"></i> رجوع
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-door-closed"></i> غرفة رقم @Model.Number</h5>
                    <span class="badge @statusBadge fs-6">@statusText</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">رقم الغرفة:</div>
                    <div class="col-md-8">@Model.Number</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">نوع الغرفة:</div>
                    <div class="col-md-8">@Model.Type</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">السعة:</div>
                    <div class="col-md-8">@Model.Capacity شخص</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">السعر / ليلة:</div>
                    <div class="col-md-8 text-success fw-bold">@Model.BaseNightlyRate.ToString("N2") ج.م</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">الحالة:</div>
                    <div class="col-md-8"><span class="badge @statusBadge">@statusText</span></div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="row">
                        <div class="col-md-4 fw-bold">ملاحظات:</div>
                        <div class="col-md-8">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('هل أنت متأكد من حذف هذه الغرفة؟')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> حذف الغرفة
                </button>
            </form>
        </div>
    </div>
</div>
