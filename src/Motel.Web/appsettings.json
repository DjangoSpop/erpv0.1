{
  "ConnectionStrings": {
    "Default": "Data Source=./AppData/motel.db",
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MotelManagement;Trusted_Connection=true;MultipleActiveResultSets=true",
    "SqlServer": "Server=localhost;Database=MotelManagement;User Id=sa;Password=YourStrongPassword123;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Branding": {
    "SiteName": "موتيل دهب - Dahab Motel",
    "LogoPath": "/images/logo.png",
    "PrimaryColor": "#2c3e50"
  },
  "Localization": {
    "DefaultCulture": "ar-EG",
    "SupportedCultures": [ "ar-EG" ]
  },
  "Invoice": {
    "DefaultTaxPercent": 14,
    "SerialPrefix": "INV"
  },
  "Email": {
    "FromName": "موتيل دهب",
    "FromAddress": "noreply@dahabmotel.local",
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/motel-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
